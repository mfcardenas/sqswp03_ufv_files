{
  "validation_rules": {
    "syntax_rules": {
      "required_fields": [
        "id",
        "title",
        "description"
      ],
      "id_format": {
        "pattern": "^REQ-\\d{3,}$",
        "message": "Requirement ID must follow format REQ-XXX"
      },
      "description_length": {
        "min_length": 10,
        "max_length": 1000,
        "message": "Description must be between 10 and 1000 characters"
      },
      "priority_values": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "type_values": [
        "functional",
        "non-functional",
        "business",
        "technical",
        "security",
        "usability",
        "compliance",
        "process",
        "documentation",
        "testing"
      ]
    },
    "semantic_rules": {
      "ambiguous_terms": [
        "etc",
        "and/or",
        "as appropriate",
        "tbd",
        "to be determined",
        "nice to have",
        "user friendly",
        "fast",
        "efficient",
        "robust"
      ],
      "passive_voice_indicators": [
        "is",
        "are",
        "was",
        "were",
        "be",
        "been",
        "being"
      ],
      "subjectivity_threshold": 0.7,
      "readability_scores": {
        "min_words": 5,
        "max_words": 100,
        "optimal_length": 25
      }
    },
    "consistency_rules": {
      "terminology_consistency": {
        "check_similar_terms": true,
        "max_term_variations": 3
      },
      "format_consistency": {
        "check_capitalization": true,
        "check_punctuation": true
      },
      "structure_consistency": {
        "check_sentence_structure": true,
        "check_list_formats": true
      }
    },
    "quality_weights": {
      "completeness": 0.20,
      "correctness": 0.20,
      "consistency": 0.15,
      "clarity": 0.15,
      "verifiability": 0.15,
      "traceability": 0.15
    }
  },
  "verification_rules": {
    "analysis": {
      "analytical_indicators": [
        "calculate",
        "compute",
        "determine",
        "evaluate",
        "analyze",
        "assess",
        "measure",
        "verify"
      ],
      "measurability_patterns": [
        "\\d+%",
        "\\d+\\s*(seconds|minutes|hours|days)",
        "less than \\d+",
        "greater than \\d+",
        "between \\d+ and \\d+",
        "at least \\d+",
        "at most \\d+"
      ],
      "confidence_weights": {
        "has_analytical_operations": 0.8,
        "has_measurable_criteria": 0.2
      }
    },
    "demonstration": {
      "ui_indicators": [
        "screen",
        "dialog",
        "window",
        "button",
        "menu",
        "form",
        "interface",
        "display",
        "show",
        "present"
      ],
      "interactive_indicators": [
        "click",
        "select",
        "enter",
        "navigate",
        "scroll",
        "drag",
        "drop"
      ],
      "confidence_weights": {
        "has_ui_elements": 0.9,
        "has_interactive_elements": 0.1
      }
    },
    "testing": {
      "testable_indicators": [
        "shall",
        "must",
        "will",
        "should"
      ],
      "untestable_indicators": [
        "etc",
        "and/or",
        "as appropriate",
        "tbd",
        "to be determined"
      ],
      "test_case_generation": {
        "functional_tests": [
          "Verify that {requirement}",
          "Validate {requirement}",
          "Test {requirement}"
        ],
        "non_functional_tests": [
          "Measure {requirement}",
          "Assess {requirement}",
          "Evaluate {requirement}"
        ]
      }
    },
    "inspection": {
      "checklist_items": [
        {
          "id": "clear_objective",
          "description": "Requirement has clear, unambiguous objective",
          "weight": 1.0
        },
        {
          "id": "measurable_criteria",
          "description": "Contains measurable acceptance criteria",
          "weight": 1.0
        },
        {
          "id": "unambiguous_language",
          "description": "Uses unambiguous, precise language",
          "weight": 1.0
        },
        {
          "id": "feasible_implementation",
          "description": "Technically feasible to implement",
          "weight": 1.0
        },
        {
          "id": "traceable_sources",
          "description": "Traceable to sources and rationale",
          "weight": 1.0
        }
      ],
      "severity_levels": {
        "critical": 1.0,
        "high": 0.8,
        "medium": 0.6,
        "low": 0.4,
        "info": 0.2
      }
    }
  },
  "review_rules": {
    "templates": {
      "functional": {
        "checklist": [
          "Requirement is clear and unambiguous",
          "Functional behavior is well defined",
          "Inputs and outputs are specified",
          "Performance criteria are defined",
          "Error handling is specified",
          "Data validation requirements are clear",
          "Integration points are identified"
        ],
        "required_reviewers": ["business_analyst", "technical_lead"],
        "estimated_duration": "2 hours"
      },
      "non-functional": {
        "checklist": [
          "Quality attribute is measurable",
          "Acceptance criteria are defined",
          "Measurement method is specified",
          "Constraints are reasonable",
          "Priority is appropriate",
          "Testability is ensured",
          "Monitoring requirements are specified"
        ],
        "required_reviewers": ["architect", "qa_lead"],
        "estimated_duration": "1.5 hours"
      },
      "technical": {
        "checklist": [
          "Technical feasibility is assessed",
          "Implementation approach is clear",
          "Dependencies are identified",
          "Risks are evaluated",
          "Resource requirements are estimated",
          "Security implications are considered",
          "Performance impact is analyzed"
        ],
        "required_reviewers": ["technical_lead", "security_officer"],
        "estimated_duration": "2.5 hours"
      }
    },
    "workflow": {
      "states": [
        "created",
        "in_progress",
        "under_review",
        "approved",
        "rejected",
        "completed"
      ],
      "transitions": {
        "created": ["in_progress"],
        "in_progress": ["under_review", "created"],
        "under_review": ["approved", "rejected", "in_progress"],
        "approved": ["completed"],
        "rejected": ["in_progress"],
        "completed": []
      }
    },
    "finding_types": [
      "clarity_issue",
      "completeness_gap",
      "consistency_problem",
      "feasibility_concern",
      "technical_issue",
      "business_alignment",
      "priority_disagreement"
    ],
    "severity_levels": [
      "critical",
      "high",
      "medium",
      "low",
      "info"
    ]
  },
  "reporting_rules": {
    "quality_thresholds": {
      "excellent": 90,
      "good": 80,
      "acceptable": 70,
      "needs_improvement": 60,
      "poor": 0
    },
    "report_formats": [
      "html",
      "pdf",
      "json",
      "csv",
      "xml"
    ],
    "metrics_to_include": [
      "overall_quality_score",
      "dimension_scores",
      "validation_results",
      "verification_confidence",
      "review_findings",
      "trend_analysis"
    ],
    "compliance_checks": [
      "iso_29148_compliance",
      "organizational_standards",
      "industry_best_practices"
    ]
  },
  "performance_rules": {
    "validation_limits": {
      "max_requirements_per_batch": 1000,
      "max_processing_time_seconds": 30,
      "max_memory_usage_mb": 500,
      "max_concurrent_requests": 10
    },
    "caching_rules": {
      "cache_validation_results": true,
      "cache_expiry_hours": 24,
      "cache_quality_metrics": true,
      "cache_review_templates": true
    },
    "optimization_rules": {
      "use_parallel_processing": true,
      "batch_database_operations": true,
      "lazy_load_large_datasets": true,
      "compress_cached_data": true
    }
  },
  "integration_rules": {
    "api_endpoints": {
      "validate_requirements": "/api/validation/validate",
      "get_quality_metrics": "/api/validation/metrics",
      "create_review": "/api/reviews",
      "get_verification_status": "/api/verification/status"
    },
    "webhook_events": [
      "validation_completed",
      "quality_threshold_breached",
      "review_created",
      "review_completed"
    ],
    "external_systems": [
      "requirements_management_system",
      "test_management_system",
      "document_management_system",
      "change_management_system"
    ]
  }
}
